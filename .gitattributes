# Auto detect text files and perform LF normalization
* text=auto

# Java source files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# SQL files
*.sql text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Docker
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Maven wrapper
*.jar binary
mvnw text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf
